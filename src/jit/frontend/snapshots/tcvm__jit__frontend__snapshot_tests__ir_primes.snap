      v14 = icmp ne v2, v13
            guard.cond v14  ; exit0
      v15 = mod.i64 v12, v2
      v16 = iconst 0
      v17 = icmp eq v15, v16
            br v17 block3, block4
block2:
      v18 = kconst true
            ret v18
block3:
      v19 = kconst false
            ret v19
block4:
      v20 = iconst 1
      v21 = add.i64 v2, v20
      v22 = icmp le v21, v6
