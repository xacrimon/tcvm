---
source: src/jit/frontend/snapshot_tests.rs
expression: "ir_of(&source, &[INT, INT])"
---
block0(v0: int, v1: int):
       v2 = iconst 0
       v3 = unpack.int v0
       v4 = unpack.int v1
       v5 = icmp lt v3, v4
            br v5 block1, block2
block1:
       v6 = iconst 1
            jump block3(v6)
block2:
       v7 = iconst 2
            jump block3(v7)
block3(v9: i64):
      v10 = iconst 10
      v11 = icmp lt v9, v10
            br v11 block4, block5
block4:
      v12 = unpack.int v0
      v13 = add.i64 v9, v12
            jump block3(v13)
block5:
      v14 = pack.int v9
            ret v14
